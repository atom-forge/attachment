{
	"name": "@atom-forge/attachment",
	"version": "0.4.0",
	"description": "Attachment management for your ORM",
	"homepage": "https://github.com/atom-forge/attachment#readme",
	"repository": {
		"url": "git://github.com/atom-forge/attachment.git"
	},
	"bugs": {
		"url": "https://github.com/atom-forge/attachment/issues"
	},
	"keywords": [
		"attachment",
		"file-upload",
		"prisma",
		"typescript",
		"s3",
		"image"
	],
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"LICENSE",
		"README.md",
		"README-AI.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"test": "bun test",
		"prepublishOnly": "bun run build",
		"release": "npm publish --access public",
		"pub-check": "bun run scripts/pub-check.ts",
		"pub": "bun run scripts/pub.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1046.0",
		"mime": "^4.0.0"
	},
	"peerDependencies": {
		"music-metadata": ">=11.12.0",
		"sharp": ">=0.32.0"
	},
	"peerDependenciesMeta": {
		"music-metadata": {
			"optional": true
		},
		"sharp": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"music-metadata": "^11.12.3",
		"sharp": "^0.34.5",
		"typescript": "^6.0.2"
	}
}
